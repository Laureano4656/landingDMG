---
interface Props {
  size?: 'large' | 'small';
  align?: 'center' | 'left';
}

const { size = 'large', align = 'center' } = Astro.props;
---

<div class={`logo logo--${size} logo--${align}`} role="img" aria-label="Contable DMG">
  <span class="bracket bracket--tl"></span>
  <span class="bracket bracket--tr"></span>
  <span class="bracket bracket--bl"></span>
  <span class="bracket bracket--br"></span>
  <div class="logo__inner">
    <span class="logo__line logo__line--sm">contable</span>
    <span class="logo__line logo__line--lg">DMG</span>
    <span class="logo__line logo__line--sm">.com.ar</span>
  </div>
</div>

<style>
  .logo {
    position: relative;
    display: inline-block;
    padding: 26px;
    color: var(--color-white);
    font-family: var(--font-family);
  }

  .logo__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
  }

  .logo--left .logo__inner {
    align-items: flex-start;
  }

  .logo__line--sm {
    font-size: 18px;
    font-weight: 300;
  }

  .logo__line--lg {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.05;
  }

  .bracket {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid currentColor;
  }

  .bracket--tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .bracket--tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
  }

  .bracket--bl {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
  }

  .bracket--br {
    bottom: 0;
    right: 0;
    border-left: 0;
    border-top: 0;
  }

  .logo--small {
    padding: 14px;
  }

  .logo--small .logo__line--sm {
    font-size: 10px;
  }

  .logo--small .logo__line--lg {
    font-size: 24px;
  }

  .logo--small .bracket {
    width: 11px;
    height: 11px;
    border-width: 1.5px;
  }

  @media (max-width: 640px) {
    .logo--large {
      padding: 20px;
    }

    .logo--large .logo__line--sm {
      font-size: 15px;
    }

    .logo--large .logo__line--lg {
      font-size: 38px;
    }

    .logo--large .bracket {
      width: 17px;
      height: 17px;
    }
  }
</style>