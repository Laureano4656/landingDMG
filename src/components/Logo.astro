---
import '../styles/Logo.css';

interface Props {
  size?: 'large' | 'small';
  align?: 'center' | 'left';
}

const { size = 'large', align = 'center' } = Astro.props;
---

<div class={`logo logo--${size} logo--${align}`} role="img" aria-label="Contable DMG">
  <img src="/Logo DMG 2.svg" alt="Contable DMG" class="logo__img" />
</div>
