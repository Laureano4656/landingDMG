---
import Nav from './Nav.astro';
import Logo from './Logo.astro';
import '../styles/Hero.css';
---

<section class="hero" id="home">
  <img class="hero__bg" src="/foto-escritorio-con-mano.png" alt="Escritorio de trabajo con laptop y monitor" />
  <div class="hero__overlay"></div>
  <Nav />
  <div class="hero__content container">
    <Logo />
    <button class="hero__btn" type="button">Iniciar sesión</button>
  </div>
  <div class="hero__tagline container">
    <p>
      Asesoramiento impositivo<br />
      <strong>claro, moderno</strong> y <strong>tu medida</strong>
    </p>
  </div>
</section>
