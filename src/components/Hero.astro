---
import Logo from './Logo.astro';
import '../styles/Hero.css';
---

<section class="hero" id="home">
  <img class="hero__bg" src="/foto-escritorio-con-mano.avif" alt="Escritorio de trabajo con laptop y monitor" />
  <div class="hero__overlay"></div>
  <div class="hero__content container">
    <Logo />
    <button class="hero__btn" type="button"><a href="http://contabledmg.com.ar/Sistema" target="_blank" rel="noopener noreferrer">Iniciar sesión</a></button>
  </div>
  <div class="hero__tagline container">
    <p>
      Asesoramiento impositivo<br />
      <strong>claro, moderno</strong> y a <strong>tu medida</strong>
    </p>
  </div>
</section>

<script>
  // On touch devices, :hover sticks after tap. Suppress it briefly after touchend.
  const btn = document.querySelector('.hero__btn');
  if (btn) {
    btn.addEventListener('touchend', () => {
      btn.classList.add('no-hover');
      btn.addEventListener('mouseleave', () => btn.classList.remove('no-hover'), { once: true });
      // Fallback: remove after 500ms in case mouseleave never fires
      setTimeout(() => btn.classList.remove('no-hover'), 500);
    });
  }
</script>
